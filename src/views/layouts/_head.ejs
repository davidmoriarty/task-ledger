<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href="<%= canonical %>" />
    <link rel="icon" href="/favicon.png" />
    <title><%= title || "TaskLedger" %></title>
    <style>
      :root { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; }
      body { margin: 0; padding: 2rem; max-width: 900px; margin-inline: auto; }
      header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
      a { color: inherit; }
      .card { border: 1px solid #ddd; border-radius: 12px; padding: 1rem; padding-bottom: 2rem; margin: 0 auto; margin-bottom: 1rem; }
      .row { display: flex; gap: .75rem; flex-wrap: wrap; align-items: flex-start; }
      .column { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .75rem; }
      input[type="text"], input[type="email"], input[type="password"] {
        padding: .6rem .7rem; border-radius: 10px; border: 1px solid #ccc; min-width: 260px;
      }
      button {
        padding: .6rem .7rem; border-radius: 10px; border: 1px solid #ccc; background: #f6f6f6; color: #111; font-weight: 500; cursor: pointer; appearance: none; -webkit-appearance: none;
        transition:
          background-color: .15s ease,
          border-color: .15s ease,
          color .15s ease;
      }
      button:hover { background: #efefef; color: #000; }
      ul { list-style: none; padding: 0; margin: 0; }
      li { display: flex; justify-content: space-between; gap: 1rem; padding: .6rem 0; border-top: 1px solid #eee; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border-width: 0; }
      .muted { color: #666; font-size: .9rem; }
      .error { color: #b00020; }

      .notice {
        position: relative;
        display: block;
        padding: 12px 44px 12px 14px;
        border: 1px solid #e6d48c;
        background: #fff7d6;
        border-radius: 10px;
        margin: 12px 0 16px;
      }

      .notice-close {
        position: absolute;
        top: 4px;
        right: 6px;

        display: grid;
        place-items: center;

        width: 32px;
        height: 32px;
        min-width: 0;
        padding: 0;

        border: 0;
        background: transparent;
        font-size: 20px;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
      }

      .notice-close:hover { background: transparent; border: 0; }

      .login-header {
        flex-direction: column;
        align-items: flex-start;
        gap: .35rem;
        margin-bottom: 1rem;
      }
      .login-header h1 { margin: 0; }
      .login-header .muted { margin: 0; font-size: 0.8rem; }

      .dashboard-header h1 {
        margin-bottom: 0;
      }

      .dashboard-header {
        flex-direction: column;
        align-items: stretch;
        margin-bottom: 1rem;
      }
      .dashboard-header > div {
        min-width: 0;
      }
      .dashboard-header form,
      .dashboard-header form button {
        box-sizing: border-box;
        width: 100%;
      }

      .login-fields {
        width: min(100%, 360px);
        margin-inline: auto;
      }
      .login-fields input, .login-fields button {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
      }

      .demo-form {
        width: min(100%, 360px);
      }

      .demo-form button {
        width: 100%;
      }

      .button-primary { background: oklch(68.5% 0.169 237.323); color: white; }
      .button-primary:hover { background: oklch(58.8% 0.158 241.966); color: white; }

      .button-demo { background: oklch(69.6% 0.17 162.48); color: white; }
      .button-demo:hover { background: oklch(59.6% 0.145 163.225); color: white; }

      .add-task-form {
        flex-direction: column;
      }
      .add-task-form input, .add-task-form button {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
      }

      .task-item {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .task-details {
        display: flex;
        flex-direction: column;
        gap: .35rem;
        min-width: 0;
      }

      .task-status {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .9rem;
      }

      .task-actions {
        display: flex;
        gap: .5rem;
      }

      .task-actions form {
        flex: 1;
      }

      .task-actions form:first-child button { min-width: 150px; }

      .task-actions button {
        width: 100%;
        white-space: nowrap;
      }

      .button-delete { color: red; background: white; border: 1px solid red; }
      .button-delete:hover { color: white; background: red; border-color: red; }

      .badge { font-size: .8rem; padding: .15rem .5rem; border: 1px solid #ddd; border-radius: 999px; }
      .badge-active { color: #0369a1; background: #e0f2fe; border: 1px solid #bae6fd; }
      .badge-completed { color: #15803d; background: #dcfce7; border: 1px solid #bbf7d0; }

      @media (min-width: 640px) {
        .dashboard-header {
          flex-direction: row;
          align-items: center;
        }

        .login-header {
          flex-direction: row;
          align-items: baseline;
          gap: 1rem;
          margin-bottom: 1rem;
        }
        .login-header .muted { margin-left: auto; }

        .dashboard-header form,
        .dashboard-header form button {
          width: auto;
        }

        .demo-form { width: auto; }
        .demo-form button { width: auto; }

        .add-task-form {
          flex-direction: row;
        }

        .add-task-form input {
          flex: 1;
        }

        .add-task-form button {
          width: auto;
          min-width: 100px;
        }

        .task-item {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
        }

        .task-details {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          column-gap: 1rem;
          flex: 1;
        }
        .task-details > strong,
        .task-details > .muted { grid-column: 1; }

        .task-status {
          grid-column: 2;
          grid-row: 1 / span 2;
          align-self: center;
          font-size: 0;
        }
        .task-status .badge { font-size: .8rem; }
        .task-actions { flex: none; align-items: center; }
        .task-actions form, .task-actions button { width: auto; }
        .task-actions form:first-child button { min-width: 132px; }
      }
    </style>
  </head>
  <body>
