<%- include("../layouts/_head", { title: "Login - TaskLedger" }) %>

<header>
  <h1>TaskLedger</h1>
  <span class="muted">Server-rendered dashboard</span>
</header>

<div class="card">
  <h2>Login</h2>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="post" action="/ui/login" class="column">
    <label for="email">
      <span>Email</span><br />
      <input id="email" name="email" type="email" autocomplete="email" required />
    </label>

    <label for="password">
      <span>Password</span><br />
      <input id="password" name="password" type="password" autocomplete="current-password" required />
    </label>

    <button type="submit">Login</button>
  </form>
</div>

<div class="card">
  <h2>Demo Login</h2>
  <p>Use this login to explore the dashboard without creating an account.</p>

  <form method="post" action="/auth/demo">
    <button type="submit">Try demo account</button>
  </form>
</div>

<%- include("../layouts/_foot") %>
