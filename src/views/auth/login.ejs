<%- include("../layouts/_head", { title: "Login - TaskLedger" }) %>

<header>
  <h1>TaskLedger</h1>
  <span class="muted">Server-rendered dashboard</span>
</header>

<div class="card">
  <h2>Login</h2>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <form method="post" action="/ui/login">
    <div class="column">
      <label for="email" class="sr-only">Email</label>
      <input id="email" name="email" type="email" placeholder="Email" autocomplete="email" required />

      <label for="password" class="sr-only">Password</label>
      <input id="password" name="password" type="password" placeholder="Password" autocomplete="current-password" required />

      <button type="submit">Login</button>
    </div>
  </form>
</div>

<div class="card">
  <h2>Demo Login</h2>
  <p>Use this login to explore the dashboard without creating an account.</p>

  <form method="post" action="/auth/demo">
    <button type="submit">Try demo account</button>
  </form>
</div>

<%- include("../layouts/_foot") %>
